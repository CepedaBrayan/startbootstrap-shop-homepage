doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='color-scheme', content='light dark')
    meta(name='darkreader-lock')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    title(data-i18n='home.title') WhatsApp Shop
    include partials/translations.pug
    script(src='js/i18n.js')
    script(src='js/scripts.js')

    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    link(href='css/styles.css', rel='stylesheet')

  body.d-flex.flex-column(style='min-height:100vh')

    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light
      .container.px-4.px-lg-5
        a.navbar-brand(href='#') WhatsApp Shop
        .d-flex.gap-2.flex-wrap
          include partials/language-toggle.pug
          include partials/theme-toggle.pug

    header.shop-header.py-5
      .container.px-4.px-lg-5.my-5.text-center
        h1.display-4.fw-bolder(data-i18n='home.heading') Choose a Category
        p.lead.text-muted(data-i18n='home.subtitle') Select where you want to go

    main.py-5.flex-grow-1
      .container.px-4.px-lg-5.mt-5
        .row.gx-4.gx-lg-5.justify-content-center

          // Apparel Card
          .col-md-6.col-lg-4.mb-5
            .card.h-100
              a(href='views/apparel.html')
                img.card-img-top.product-image(
                  src='assets/img/shoes/hail-clay-1.avif'
                  alt='Apparel'
                  data-i18n-alt='category.apparel'
                )
              .card-body.p-4.text-center
                h2.h4.fw-bolder.mb-0(data-i18n='category.apparel') Apparel

          // Garage Card
          .col-md-6.col-lg-4.mb-5
            .card.h-100
              a(href='views/garage.html')
                img.card-img-top.product-image(
                  src='assets/img/garage/xbox-2.jpg'
                  alt='Garage Sale'
                  data-i18n-alt='category.garage'
                )
              .card-body.p-4.text-center
                h2.h4.fw-bolder.mb-0(data-i18n='category.garage') Garage Sale

    footer.py-5.shop-footer
      .container
        p.m-0.text-center.text-muted(data-i18n='footer.copyright') Copyright © WhatsApp Shop 2026
