doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    title WhatsApp Shop

    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    link(href='css/styles.css', rel='stylesheet')

  body.d-flex.flex-column(style='min-height:100vh')

    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light
      .container.px-4.px-lg-5
        a.navbar-brand(href='#') WhatsApp Shop

    // Main section
    main.flex-grow-1.d-flex.align-items-center
      .container.px-4.px-lg-5
        .row.justify-content-center.text-center.mb-4
          .col-lg-8
            h1.display-5.fw-bolder.mb-3 Choose a Category
            p.lead.text-muted Select where you want to go

        .row.gx-4.gx-lg-5.justify-content-center

          // Shoes Card
          .col-md-6.col-lg-4.mb-4
            .card.h-100.shadow-sm
              a(href='views/shoes.html')
                img.card-img-top.product-image(
                  src='assets/img/shoes/hail-clay-1.avif'
                  alt='Shoes'
                )
              .card-body.text-center
                h4.fw-bolder Shoes

          // Garage Card
          .col-md-6.col-lg-4.mb-4
            .card.h-100.shadow-sm
              a(href='views/garage.html')
                img.card-img-top.product-image(
                  src='assets/img/garage/xbox-2.jpg'
                  alt='Garage Sale'
                )
              .card-body.text-center
                h4.fw-bolder Garage Sale

    footer.py-3.bg-light
      .container
        p.m-0.text-center.text-muted © WhatsApp Shop 2026
