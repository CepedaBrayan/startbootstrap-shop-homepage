doctype html
- const WHATSAPP = process.env.WPP_ID
include ../partials/catalog-mixins.pug
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    meta(name='description', content='Apparel Collection')
    title Apparel - WhatsApp Shop
    script(src='../js/scripts.js')
    link(rel='icon', type='image/x-icon', href='../assets/favicon.ico')
    link(href='../css/styles.css', rel='stylesheet')
  body.d-flex.flex-column(style='min-height:100vh')
    nav.navbar.navbar-expand-lg.navbar-light.bg-light
      .container.px-4.px-lg-5
        a.navbar-brand(href='../index.html') ← Back to Home
        include ../partials/theme-toggle.pug
    header.bg-dark.py-5
      .container.px-4.px-lg-5.my-5.text-center.text-white
        h1.display-4.fw-bolder Apparel
        p.lead.text-white-50 Escríbenos por WhatsApp para comprar
    main.py-5.flex-grow-1
      .container.px-4.px-lg-5.mt-5
        .row.gx-4.gx-lg-5.row-cols-2.row-cols-md-3.row-cols-xl-4.justify-content-center
          each product in products.apparel
            +productCard(product)
    each product in products.apparel
      if product.images.length
        +productModal(product)
    footer.py-5.bg-dark
      .container
        p.m-0.text-center.text-white Copyright © WhatsApp Shop 2026
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
