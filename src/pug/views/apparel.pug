doctype html
- const WHATSAPP = process.env.WPP_ID
include ../partials/catalog-mixins.pug
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='color-scheme', content='light dark')
    meta(name='darkreader-lock')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    meta(name='description', content='Apparel Collection', data-i18n-content='apparel.description')
    title(data-i18n='apparel.title') Apparel - WhatsApp Shop
    include ../partials/translations.pug
    script(src='../js/i18n.js')
    script(src='../js/scripts.js')
    script(src='../js/catalog-sort.js', defer)
    link(rel='icon', type='image/x-icon', href='../assets/favicon.ico')
    link(href='../css/styles.css', rel='stylesheet')
  body.d-flex.flex-column(style='min-height:100vh')
    nav.navbar.navbar-expand-lg.navbar-light.bg-light
      .container.px-4.px-lg-5
        a.navbar-brand(href='../index.html', data-i18n='nav.back') ← Back to Home
        .d-flex.gap-2.flex-wrap
          include ../partials/language-toggle.pug
          include ../partials/theme-toggle.pug
    header.shop-header.py-5
      .container.px-4.px-lg-5.my-5.text-center
        h1.display-4.fw-bolder(data-i18n='category.apparel') Apparel
        p.lead.text-muted(data-i18n='apparel.subtitle') Escríbenos por WhatsApp para comprar
    main.py-5.flex-grow-1
      .container.px-4.px-lg-5.mt-5
        +productCatalog(products.apparel)
        section.mt-5.p-4.border.rounded(aria-labelledby='warranty-heading')
          h2.h4#warranty-heading(data-i18n='apparel.warranty.title') Warranty and special pricing
          p.mb-0.text-muted(data-i18n='apparel.warranty.description') All our products are new and authentic. As imported products, they do not come with a manufacturer’s warranty; this is why they are offered at a significantly reduced price.
    each product in products.apparel
      if product.images.length
        +productModal(product)
    footer.py-5.shop-footer
      .container
        p.m-0.text-center.text-muted(data-i18n='footer.copyright') Copyright © WhatsApp Shop 2026
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
