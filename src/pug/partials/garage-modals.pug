// ================= GARAGE MODALS WITH CAROUSELS =================

// Modal 1 - Xbox Series S + Control
.modal.fade#modal-xbox(tabindex='-1')
  .modal-dialog.modal-lg.modal-dialog-centered
    .modal-content
      .modal-header
        h5.modal-title Xbox Series S + Control
        button.btn-close(type='button', data-bs-dismiss='modal')
      .modal-body.p-0
        .carousel.slide#carousel-xbox(data-bs-ride='carousel')
          .carousel-inner
            .carousel-item.active
              img.d-block.w-100(src='../assets/img/garage/xbox-1.jpg')
            .carousel-item
              img.d-block.w-100(src='../assets/img/garage/xbox-2.jpg')
          button.carousel-control-prev(type='button', data-bs-target='#carousel-xbox', data-bs-slide='prev')
            span.carousel-control-prev-icon
          button.carousel-control-next(type='button', data-bs-target='#carousel-xbox', data-bs-slide='next')
            span.carousel-control-next-icon


