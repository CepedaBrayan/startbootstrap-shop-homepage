mixin productCard(product)
  .col.mb-5
    .card.h-100
      if product.images.length
        button.product-photo(type='button', data-bs-toggle='modal', data-bs-target=`#modal-${product.id}`, aria-label=`View photos: ${product.name}`, data-i18n-aria-label='photo.view', data-product-id=product.id)
          img.card-img-top.product-image(src=`../assets/img/${product.images[0]}`, alt=product.name, data-i18n-alt=`products.${product.id}`, loading='lazy')
      else
        .product-placeholder(role='img', aria-label=`${product.name}: photo coming soon`, data-i18n='photo.pending', data-i18n-aria-label='photo.pendingAlt', data-product-id=product.id) Photo coming soon
      .card-body.p-4.text-center
        h5.fw-bolder(data-i18n=`products.${product.id}`)= product.name
        if product.size
          p.mb-2(data-i18n='product.size', data-i18n-params=JSON.stringify({size: product.size + (product.sizeUnit ? ' ' + product.sizeUnit : '')})) Size #{product.size}#{product.sizeUnit ? ' ' + product.sizeUnit : ''}
        p.mb-2.text-muted(data-i18n=`product.available.${product.quantity === 1 ? 'one' : 'other'}`, data-i18n-params=JSON.stringify({count: product.quantity})) #{product.quantity} available
        p.mb-0
          span= '$' + product.price.toLocaleString('es-CO') + ' COP'
          if product.id === 'puma-premium-socks'
            span(data-i18n='product.pair')  / pair
      .card-footer.p-4.pt-0.border-top-0.bg-transparent.text-center
        a.btn.btn-success(href=`https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola, me interesa ' + product.name + (product.size ? ' (talla ' + product.size + (product.sizeUnit ? ' ' + product.sizeUnit : '') + ')' : ''))}`, target='_blank', rel='noopener noreferrer', data-whatsapp-product=product.id, data-product-size=product.size ? product.size + (product.sizeUnit ? ' ' + product.sizeUnit : '') : '', data-i18n='whatsapp.label') WhatsApp

mixin productModal(product)
  .modal.fade(id=`modal-${product.id}`, tabindex='-1', aria-labelledby=`title-${product.id}`, aria-hidden='true')
    .modal-dialog.modal-lg.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title(id=`title-${product.id}`, data-i18n=`products.${product.id}`)= product.name
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close', data-i18n-aria-label='modal.close')
        .modal-body
          .carousel.slide(id=`carousel-${product.id}`)
            .carousel-inner
              each image, index in product.images
                .carousel-item(class=index === 0 ? 'active' : '')
                  img.d-block.w-100(src=`../assets/img/${image}`, alt=`${product.name} — photo ${index + 1}`, data-i18n-alt='photo.alt', data-product-id=product.id, data-i18n-params=JSON.stringify({number: index + 1}), loading='lazy')
            if product.images.length > 1
              button.carousel-control-prev(type='button', data-bs-target=`#carousel-${product.id}`, data-bs-slide='prev', aria-label='Previous photo', data-i18n-aria-label='photo.previous')
                span.carousel-control-prev-icon(aria-hidden='true')
              button.carousel-control-next(type='button', data-bs-target=`#carousel-${product.id}`, data-bs-slide='next', aria-label='Next photo', data-i18n-aria-label='photo.next')
                span.carousel-control-next-icon(aria-hidden='true')
