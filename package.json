{
    "title": "Shop Homepage",
    "name": "startbootstrap-shop-homepage",
    "version": "5.0.6",
    "scripts": {
        "build": "npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets",
        "build:assets": "node scripts/build-assets.js",
        "build:pug": "node scripts/build-pug.js",
        "build:scripts": "node scripts/build-scripts.js",
        "build:scss": "node scripts/build-scss.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build && node scripts/start.js",
        "start:debug": "npm run build && node scripts/start-debug.js"
    },
    "description": "A shop homepage HTML template built with Bootstrap",
    "keywords": [
        "css",
        "sass",
        "html",
        "responsive",
        "theme",
        "template"
    ],
    "homepage": "https://startbootstrap.com/template/shop-homepage",
    "bugs": {
        "url": "https://github.com/StartBootstrap/startbootstrap-shop-homepage/issues",
        "email": "feedback@startbootstrap.com"
    },
    "license": "MIT",
    "author": "Start Bootstrap",
    "contributors": [
        "David Miller (https://davidmiller.io/)"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/StartBootstrap/startbootstrap-shop-homepage.git"
    },
    "dependencies": {
        "bootstrap": "5.2.3"
    },
    "devDependencies": {
        "autoprefixer": "10.4.14",
        "browser-sync": "3.0.4",
        "chokidar": "3.6.0",
        "concurrently": "6.3.0",
        "dotenv": "^17.2.4",
        "postcss": "8.5.30",
        "prettier": "2.8.6",
        "pug": "3.0.4",
        "sass": "1.105.1",
        "shelljs": "0.10.0",
        "upath": "2.0.1"
    }
}
